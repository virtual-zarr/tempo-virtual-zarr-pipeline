# Account- and operator-specific values, kept out of the committed
# per-dataset env files. Copy to .env.local (gitignored) and fill in, then
# pass it AFTER the dataset file so it can also override dataset settings:
#   uv run --env-file .env_hcho --env-file .env.local cdk deploy
# The scripts' -e flag reads missing keys from .env.local automatically.

ACCOUNT_ID=
# Picked up by the CDK CLI, the scripts run via `uv run --env-file`, and
# `start_backfill.sh -e`; an already-exported AWS_PROFILE wins for the latter.
AWS_PROFILE=

# Cost-allocation tags for the sandbox test (Stage/Project/Stack/Collection
# are tagged automatically). Set CLIENT for the client-infrastructure deploy.
OWNER=
# CLIENT=

# Email for the DLQ / scheduled-job failure alarms (alarms exist regardless).
# ALARM_EMAIL=

# Garbage collection runs in an AWS Batch cluster inside a VPC. Enabling it
# requires VPC_ID plus GARBAGE_COLLECTION_FREQUENCY (dataset file), and
# `cdk synth` will then perform a VPC lookup that needs real AWS credentials
# for ACCOUNT_ID.
# VPC_ID=vpc-0123456789abcdef0

# Earthdata Login for reading protected source granules (Secrets Manager
# JSON with "token" or "username"+"password"). REQUIRED for the sandbox:
# the account has no bucket-policy grant on asdc-prod-protected, so without
# this every worker read fails with AccessDenied. Create once (shared by
# both collections) and paste the returned ARN:
#   aws secretsmanager create-secret --name tempo-earthdata \
#     --secret-string '{"token":"<EDL token>"}' \
#     --region us-west-2 --profile <PROFILE>
EARTHDATA_SECRET_ARN=
