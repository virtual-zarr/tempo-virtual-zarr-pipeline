# Dataset-layer config. Account- and operator-specific values (ACCOUNT_ID,
# AWS_PROFILE, OWNER, ALARM_EMAIL, VPC_ID, EARTHDATA_SECRET_ARN) live in the
# gitignored .env.local — see .env.local.sample. Run with both files:
#   uv run --env-file .env_hcho --env-file .env.local cdk deploy
STACK_NAME=virtualizarr-data-pipelines
STAGE="dev"
# GARBAGE_COLLECTION_FREQUENCY=2  # requires VPC_ID (.env.local); leave unset for tests

# Forward SQS consumer. Leave unset to default: enabled normally, but disabled
# automatically when BACKFILL_ENABLED=true (so the backfill bootstraps main first).
# After the backfill promotes, set FORWARD_QUEUE_ENABLED=true and redeploy.
# FORWARD_QUEUE_ENABLED=false

STAGE=dev
ACCOUNT_REGION=
# Snapshots older than this are expired by GC (also the rollback window).
# GC_EXPIRY_DAYS=30

# Existing bucket for the Icechunk store (must be in ACCOUNT_REGION; deploys
# fail otherwise). Unset => a bucket named ICECHUNK_BUCKET_NAME is created.
# ICECHUNK_BUCKET=
# Scope all pipeline output to this key prefix; use one prefix per collection —
# every IAM grant in the stack is scoped under it. ICECHUNK_PREFIX is relative
# to it.
# S3_PREFIX=tempo/hcho
# ICECHUNK_PREFIX=v04
# Where the partition Lambda may read backfill inventories from.
# INVENTORY_PREFIX=tempo/hcho/inventory

# --- TEMPO-specific configuration -------------------------------------------
# Which collection this instance processes (one repo per collection).
# TEMPO_COLLECTION=hcho
# Virtual chunk container prefix (processor default: s3://asdc-prod-protected/).
# VIRTUAL_CHUNK_PREFIX=s3://asdc-prod-protected/
# Forward-processing state artifacts default to
# s3://<icechunk bucket>/<S3_PREFIX>/<ICECHUNK_PREFIX>/state/*.json; override here if needed.
# STORE_MANIFEST_URI=
# PENDING_LEDGER_URI=
# POLL_WATERMARK_URI=
# Scheduled forward jobs (deployed only when the forward queue is enabled).
# RESORT_SCHEDULE_HOURS=24
# POLL_SCHEDULE_MINUTES=30
# First-poll start: set to the backfill inventory's built_at (jq -r .built_at
# on the inventory json) when enabling forward processing; unset, the first
# poll falls back to an 8-day lookback and floods the queue.
# POLL_START_ISO=
# Max pending granules one re-sort run parses; the rest drain on later runs.
# RESORT_MAX_FOLD=500
