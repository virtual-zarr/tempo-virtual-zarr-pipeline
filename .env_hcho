# TEMPO_HCHO_L3 V04 deployment — configured for a TEST RUN in the
# sandbox sub-account, ahead of the client deploy.
#
# This file is committed and holds only dataset config. Account- and
# operator-specific values (ACCOUNT_ID, AWS_PROFILE, OWNER,
# EARTHDATA_SECRET_ARN, ...) live in the gitignored .env.local — copy
# .env.local.sample to .env.local and fill it in.
#
# Deploy with:
#   uv run --env-file .env_hcho --env-file .env.local cdk deploy
STACK_NAME=tempo-hcho
PROJECT=AIR4US
PROJECT_NAME=AIR4US
STAGE=dev
ACCOUNT_REGION=us-west-2

# Shared store bucket for both collections, in ACCOUNT_REGION (checked at
# deploy).
ICECHUNK_BUCKET=airquality-data-store-develop

# Per-collection prefix: every IAM grant in this stack is scoped under
# S3_PREFIX, so the two stacks sharing the bucket cannot touch each other's
# keys. All output lives under s3://<bucket>/tempo/hcho/ (inventory at
# inventory/, run scratch at backfill/), the store at
# s3://<bucket>/tempo/hcho/v04/.
S3_PREFIX=tempo/hcho
# v04-trial: scratch store for the 50-granule sandbox trial (--max-count 50
# on the inventory). Switch to v04, with a full inventory, for the real run.
ICECHUNK_PREFIX=v04

TEMPO_COLLECTION=hcho
DATA_BUCKET_NAME=asdc-prod-protected

# Backfill-first: the forward consumer stays disabled until the backfill has
# promoted. Then set FORWARD_QUEUE_ENABLED=true and redeploy.
BACKFILL_ENABLED=true
# FORWARD_QUEUE_ENABLED=true
# POLL_START_ISO=2026-08-24T23:17:58.751036+00:00
# Fold size that fits the resort Lambda 15-min ceiling when inserts
# dominate (2026-08-27 timeout incident; runbook-drain-pending-backlog).
# Tune upward from measured drain durations: largest N under ~60% of 900s.
# RESORT_MAX_FOLD=50
