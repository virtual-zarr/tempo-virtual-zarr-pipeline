# TEMPO_NO2_L3 V04 deployment — configured for a TEST RUN in the
# ds-sandbox-max sub-account (755329541016), ahead of the client deploy.
# Deploy with:
#   uv run --env-file .env_no2 cdk deploy
STACK_NAME=tempo-no2
PROJECT=EODC
PROJECT_NAME=EODC
STAGE=dev
ACCOUNT_ID=755329541016
ACCOUNT_REGION=us-west-2
# Picked up by the CDK CLI, the scripts run via `uv run --env-file`, and
# `start_backfill.sh -e`; an already-exported AWS_PROFILE wins for the latter.
AWS_PROFILE=ds-sandbox-max

# Cost-allocation tags for the sandbox test (Stage/Project/Stack/Collection
# are tagged automatically). Set CLIENT for the client-infrastructure deploy.
OWNER=ds-sandbox-max
# CLIENT=

# Shared store bucket for both collections, in ACCOUNT_REGION (checked at
# deploy). Use the same bucket as .env_hcho; the per-collection S3_PREFIX
# keeps the stacks' output separate.
ICECHUNK_BUCKET=tempo-virtual-store-sandbox

# Per-collection prefix: every IAM grant in this stack is scoped under
# S3_PREFIX, so the two stacks sharing the bucket cannot touch each other's
# keys. All output lives under s3://<bucket>/tempo/no2/ (inventory at
# inventory/, run scratch at backfill/), the store at
# s3://<bucket>/tempo/no2/v04/.
S3_PREFIX=tempo/no2
ICECHUNK_PREFIX=v04

TEMPO_COLLECTION=no2
DATA_BUCKET_NAME=asdc-prod-protected

# Backfill-first: the forward consumer stays disabled until the backfill has
# promoted. Then set FORWARD_QUEUE_ENABLED=true and redeploy.
BACKFILL_ENABLED=true
# FORWARD_QUEUE_ENABLED=true

# Earthdata Login for reading protected source granules (Secrets Manager
# JSON with "token" or "username"+"password"). REQUIRED for the sandbox:
# the account has no bucket-policy grant on asdc-prod-protected, so without
# this every worker read fails with AccessDenied. Use the same secret as
# .env_hcho (creation command there).
EARTHDATA_SECRET_ARN=
